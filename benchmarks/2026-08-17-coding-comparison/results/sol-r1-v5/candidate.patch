+test("early raw response usage is filtered by turn before immutable response deduplication", async () => {
+  const instance = backend();
+  try {
+    const response = await instance.run(request("token-usage-race", "emit-token-usage-race"));
+    assert.deepEqual(response.tokenUsage, {
+      totalTokens: 10,
+      inputTokens: 7,
+      cachedInputTokens: 2,
+      cacheWriteInputTokens: 0,
+      outputTokens: 3,
+      reasoningOutputTokens: 1,
+    });
+    assert.equal(response.tokenUsageComplete, false);
+  } finally {
+    await instance.close();
+  }
+});
+
+test("failed turns retain deferred raw response usage and completeness", async () => {
+  const instance = backend();
+  try {
+    await assert.rejects(
+      instance.run(request("token-usage-failed", "emit-token-usage-failed")),
+      (error: unknown) => {
+        const observed = error as Error & {
+          tokenUsage?: Record<string, number>;
+          tokenUsageComplete?: boolean;
+        };
+        assert.match(observed.message, /synthetic turn failure/);
+        assert.deepEqual(observed.tokenUsage, {
+          totalTokens: 10,
+          inputTokens: 7,
+          cachedInputTokens: 2,
+          cacheWriteInputTokens: 0,
+          outputTokens: 3,
+          reasoningOutputTokens: 1,
+        });
+        assert.equal(observed.tokenUsageComplete, true);
+        return true;
+      },
+    );
+  } finally {
+    await instance.close();
+  }
+});
+
+test("aborted turns retain observed raw response usage and completeness", async () => {
+  const stderr: string[] = [];
+  const instance = new CodexAppServerBackend({
+    workspace: process.cwd(),
+    codexPath: process.execPath,
+    codexArgs: [fakeCodex],
+    config: DEFAULT_CONFIG,
+    onStderr: (line) => stderr.push(line),
+  });
+  const controller = new AbortController();
+  try {
+    const result = instance.run(
+      request("token-usage-aborted", "emit-token-usage-aborted"),
+      controller.signal,
+    );
+    await waitUntil(() => stderr.includes("USAGE_EMITTED"));
+    controller.abort();
+    await assert.rejects(result, (error: unknown) => {
+      const observed = error as Error & {
+        tokenUsage?: Record<string, number>;
+        tokenUsageComplete?: boolean;
+      };
+      assert.equal(observed.name, "AbortError");
+      assert.deepEqual(observed.tokenUsage, {
+        totalTokens: 12,
+        inputTokens: 8,
+        cachedInputTokens: 2,
+        cacheWriteInputTokens: 0,
+        outputTokens: 4,
+        reasoningOutputTokens: 1,
+      });
+      assert.equal(observed.tokenUsageComplete, true);
+      return true;
+    });
+  } finally {
+    await instance.close();
+  }
+});
+
