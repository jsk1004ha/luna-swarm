+const earlyTokenUsage = {
+  totalTokens: 10,
+  inputTokens: 7,
+  cachedInputTokens: 2,
+  cacheWriteInputTokens: 1,
+  outputTokens: 3,
+  reasoningOutputTokens: 1,
+};
+
+test("raw response usage waits for turn/start and only counts the exact turn once", async () => {
+  const instance = backend();
+  try {
+    const response = await instance.run(request("early-token-usage", "emit-early-token-usage"));
+    assert.deepEqual(response.tokenUsage, earlyTokenUsage);
+    assert.equal(response.tokenUsageComplete, false);
+  } finally {
+    await instance.close();
+  }
+});
+
+test("failed turns retain deferred exact-turn usage and completeness", async () => {
+  const instance = backend();
+  try {
+    await assert.rejects(
+      instance.run(request("early-token-usage-failed", "emit-early-token-usage-failed")),
+      (error: unknown) => {
+        const failure = error as Error & {
+          tokenUsage?: typeof earlyTokenUsage;
+          tokenUsageComplete?: boolean;
+        };
+        assert.match(failure.message, /synthetic turn failure/);
+        assert.deepEqual(failure.tokenUsage, earlyTokenUsage);
+        assert.equal(failure.tokenUsageComplete, true);
+        return true;
+      },
+    );
+  } finally {
+    await instance.close();
+  }
+});
+
+test("aborted turns retain deferred exact-turn usage and completeness", async () => {
+  const stderr: string[] = [];
+  const instance = new CodexAppServerBackend({
+    workspace: process.cwd(),
+    codexPath: process.execPath,
+    codexArgs: [fakeCodex],
+    config: DEFAULT_CONFIG,
+    onStderr: (line) => stderr.push(line),
+  });
+  try {
+    const controller = new AbortController();
+    const result = instance.run(
+      request("early-token-usage-abort", "emit-early-token-usage-abort"),
+      controller.signal,
+    );
+    await waitUntil(() => stderr.includes("EARLY_USAGE_READY"));
+    controller.abort();
+    await assert.rejects(result, (error: unknown) => {
+      const abort = error as Error & {
+        tokenUsage?: typeof earlyTokenUsage;
+        tokenUsageComplete?: boolean;
+      };
+      assert.equal(abort.name, "AbortError");
+      assert.deepEqual(abort.tokenUsage, earlyTokenUsage);
+      assert.equal(abort.tokenUsageComplete, true);
+      return true;
+    });
+    await waitUntil(() => stderr.some((line) => line === "ACTIVE 0 MAX 1"));
+  } finally {
+    await instance.close();
+  }
+});
+
