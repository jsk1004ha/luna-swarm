+test("raw response usage waits for the turn ID and makes the first exact-turn response immutable", async () => {
+  const instance = backend();
+  try {
+    const response = await instance.run(request("early-token-usage", "early-token-usage-success"));
+    assert.deepEqual(response.tokenUsage, {
+      totalTokens: 50,
+      inputTokens: 35,
+      cachedInputTokens: 5,
+      cacheWriteInputTokens: 0,
+      outputTokens: 15,
+      reasoningOutputTokens: 5,
+    });
+    assert.equal(response.tokenUsageComplete, false);
+  } finally {
+    await instance.close();
+  }
+});
+
+test("early exact-turn usage is preserved on failed and aborted turns", async () => {
+  const expectedUsage = {
+    totalTokens: 50,
+    inputTokens: 35,
+    cachedInputTokens: 5,
+    cacheWriteInputTokens: 0,
+    outputTokens: 15,
+    reasoningOutputTokens: 5,
+  };
+
+  const failed = backend();
+  try {
+    await assert.rejects(
+      failed.run(request("early-token-usage-failed", "early-token-usage-failed")),
+      (error: Error & { tokenUsage?: unknown; tokenUsageComplete?: boolean }) => {
+        assert.equal(error.message, "early usage failure");
+        assert.deepEqual(error.tokenUsage, expectedUsage);
+        assert.equal(error.tokenUsageComplete, true);
+        return true;
+      },
+    );
+  } finally {
+    await failed.close();
+  }
+
+  const aborted = backend();
+  try {
+    await aborted.run(request("early-token-usage-abort", "warmup"));
+    const controller = new AbortController();
+    const result = aborted.run(
+      request("early-token-usage-abort", "early-token-usage-abort"),
+      controller.signal,
+    );
+    setTimeout(() => controller.abort(), 20);
+    await assert.rejects(
+      result,
+      (error: Error & { tokenUsage?: unknown; tokenUsageComplete?: boolean }) => {
+        assert.equal(error.name, "AbortError");
+        assert.deepEqual(error.tokenUsage, expectedUsage);
+        assert.equal(error.tokenUsageComplete, true);
+        return true;
+      },
+    );
+  } finally {
+    await aborted.close();
+  }
+});
+
