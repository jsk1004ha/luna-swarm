{
  "name": "luna-swarm",
  "version": "0.1.0",
  "description": "Adaptive vertical organizations of ChatGPT-authenticated Codex Luna agents",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jsk1004ha/luna-swarm.git"
  },
  "type": "module",
  "private": true,
  "workspaces": [
    "ui"
  ],
  "bin": {
    "luna-swarm": "./dist/src/cli.js"
  },
  "files": [
    "dist/src/",
    "ui/dist/",
    "DESIGN.md",
    "SECURITY.md",
    "docs/",
    "examples/"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && npm run build:ui",
    "build:server": "tsc -p tsconfig.json",
    "build:ui": "npm run build --workspace=luna-swarm-ui",
    "dashboard": "tsx src/cli.ts dashboard",
    "dev": "tsx src/cli.ts",
    "dev:ui": "npm run dev --workspace=luna-swarm-ui",
    "start": "node dist/src/cli.js",
    "test": "npm run test:server && npm run test:ui",
    "test:server": "node scripts/test-server.mjs all",
    "test:server:fast": "node scripts/test-server.mjs fast",
    "test:server:serial": "node scripts/test-server.mjs serial",
    "test:coding-harness-quality": "node scripts/test-coding-harness-quality.mjs",
    "test:ui": "npm test --workspace=luna-swarm-ui",
    "lint": "eslint \"src/**/*.ts\" \"test/**/*.ts\" \"ui/src/**/*.{ts,tsx}\" && node scripts/check-import-cycles.mjs",
    "check": "tsc -p tsconfig.json --noEmit && npm run check --workspace=luna-swarm-ui",
    "ui": "tsx src/cli.ts ui"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "dependencies": {
    "@openai/codex-sdk": "0.147.0",
    "@resvg/resvg-js": "2.6.2",
    "pdfkit": "0.19.1",
    "typescript": "^7.0.2",
    "ws": "8.21.3",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/pdfkit": "0.17.6",
    "@types/ws": "8.18.1",
    "eslint": "10.8.1",
    "tsx": "^4.20.0",
    "typescript-eslint": "8.67.0"
  }
}
