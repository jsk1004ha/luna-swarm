{
  "name": "luna-swarm",
  "version": "0.1.0",
  "description": "Adaptive vertical organizations of ChatGPT-authenticated Codex Luna agents",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jsk1004ha/luna-swarm.git"
  },
  "homepage": "https://github.com/jsk1004ha/luna-swarm#readme",
  "bugs": {
    "url": "https://github.com/jsk1004ha/luna-swarm/issues"
  },
  "keywords": [
    "ai-agents",
    "codex",
    "github-actions",
    "multi-agent-system",
    "orchestration",
    "oss-maintenance"
  ],
  "type": "module",
  "workspaces": [
    "ui"
  ],
  "bin": {
    "luna-swarm": "./dist/src/cli.js",
    "luna-oss-readiness": "./scripts/oss-readiness.mjs"
  },
  "files": [
    "dist/",
    "ui/dist/",
    "scripts/oss-readiness.mjs",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "GOVERNANCE.md",
    "CODE_OF_CONDUCT.md",
    "DESIGN.md",
    "SECURITY.md",
    "docs/",
    "examples/"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && npm run build:ui",
    "build:server": "tsc -p tsconfig.json",
    "build:ui": "npm run build --workspace=luna-swarm-ui",
    "dashboard": "tsx src/cli.ts dashboard",
    "dev": "tsx src/cli.ts",
    "dev:ui": "npm run dev --workspace=luna-swarm-ui",
    "oss-readiness": "node scripts/oss-readiness.mjs --root .",
    "start": "node dist/src/cli.js",
    "test": "npm run test:server && npm run test:ui && npm run test:oss",
    "test:server": "node --import tsx --test --test-concurrency=1 test/**/*.test.ts",
    "test:ui": "npm test --workspace=luna-swarm-ui",
    "test:oss": "node --test scripts/oss-readiness.test.mjs",
    "check": "tsc -p tsconfig.json --noEmit && npm run check --workspace=luna-swarm-ui",
    "ui": "tsx src/cli.ts ui"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "dependencies": {
    "@openai/codex-sdk": "0.147.0",
    "typescript": "^5.9.0",
    "ws": "8.21.3",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/ws": "8.18.1",
    "tsx": "^4.20.0"
  }
}
